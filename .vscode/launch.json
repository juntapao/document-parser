{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug (Docker Symfony)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "/app": "${workspaceFolder}"
      }
    },
    {
      "name": "Run current PHP script",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003
    }
  ]
}